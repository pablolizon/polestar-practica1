<Application x:Class="PolestarApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:PolestarApp.Models"
             StartupUri="InicioWindow.xaml">
    <Application.Resources>

        <!-- =========================================================
             PALETA (tokens de color). Inspiración: diseño escandinavo,
             fondos neutros, un único color de acento.
             Contrastes comprobados contra fondo blanco (WCAG AA):
             Texto #111111 ≈ 18.9:1 · Secundario #595959 ≈ 7:1
             ========================================================= -->
        <SolidColorBrush x:Key="BrFondo"         Color="#F5F5F2"/>
        <SolidColorBrush x:Key="BrSuperficie"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrSuperficieAlt" Color="#EFEFEA"/>
        <SolidColorBrush x:Key="BrTexto"         Color="#111111"/>
        <SolidColorBrush x:Key="BrSecundario"    Color="#595959"/>
        <SolidColorBrush x:Key="BrBorde"         Color="#D9D9D4"/>
        <SolidColorBrush x:Key="BrAcento"        Color="#C8922A"/>
        <SolidColorBrush x:Key="BrPrimario"      Color="#111111"/>
        <SolidColorBrush x:Key="BrPrimarioHover" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="BrFoco"          Color="#2F6FD6"/>
        <SolidColorBrush x:Key="BrExito"         Color="#1E6B3A"/>
        <SolidColorBrush x:Key="BrExitoFondo"    Color="#E7F4EC"/>
        <SolidColorBrush x:Key="BrAviso"         Color="#8A5A00"/>

        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad"/>

        <!-- ===================== TIPOGRAFÍA ===================== -->
        <Style x:Key="TxtH1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TxtH2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TxtH3" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
        </Style>
        <Style x:Key="TxtCuerpo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="TxtSecundario" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrSecundario}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TxtIcono" TargetType="TextBlock">
            <!-- Fuente de iconos del sistema Windows (Segoe MDL2 Assets) -->
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
        </Style>

        <!-- Indicador de foco de teclado claramente visible (accesibilidad) -->
        <Style x:Key="EstiloFoco">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="6" RadiusY="6" SnapsToDevicePixels="True"
                                   Stroke="{StaticResource BrFoco}" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== BOTONES ===================== -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BtnPrimario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource BrPrimario}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BrPrimarioHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecundario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{StaticResource BrTexto}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BrSuperficieAlt}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón claro para usar sobre fondos oscuros (banner de campañas) -->
        <Style x:Key="BtnClaro" TargetType="Button" BasedOn="{StaticResource BtnPrimario}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#E8E8E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnEnlace" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,2">
                            <Border x:Name="Linea" BorderThickness="0,0,0,1" BorderBrush="Transparent">
                                <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Linea" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnLogo" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón del menú de navegación.
             Tag="Activo" marca la sección actual: el subrayado se anima (150 ms) -->
        <Style x:Key="BtnNav" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="{StaticResource BrSecundario}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <Rectangle x:Name="Subrayado" Height="2" VerticalAlignment="Bottom" Margin="12,0"
                                       Fill="{StaticResource BrAcento}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Activo">
                                <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Subrayado"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Subrayado"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón circular semitransparente (flechas del carrusel) -->
        <Style x:Key="BtnIconoCarrusel" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" CornerRadius="20" Background="#55000000">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="Segoe MDL2 Assets" TextElement.FontSize="14"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#99000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de icono plano (cerrar panel de detalle) -->
        <Style x:Key="BtnIconoPlano" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" CornerRadius="18" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="Segoe MDL2 Assets" TextElement.FontSize="14"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BrSuperficieAlt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Punto indicador del carrusel. Zona de clic de 20x20 aunque el punto mida 8x8 -->
        <Style x:Key="BtnPunto" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Punto" Width="8" Height="8" Fill="White" Opacity="0.45"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Activo">
                                <Setter TargetName="Punto" Property="Opacity" Value="1"/>
                                <Setter TargetName="Punto" Property="Width" Value="10"/>
                                <Setter TargetName="Punto" Property="Height" Value="10"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Punto" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta clicable: al pasar el ratón se eleva 4 px y aparece una sombra (150 ms) -->
        <Style x:Key="BtnTarjeta" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Raiz" Background="Transparent">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Grid.RenderTransform>
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0" Color="#000000"/>
                            </Grid.Effect>
                            <ContentPresenter/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Raiz"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="-4" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Raiz"
                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                             To="0.16" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Raiz"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Raiz"
                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Raiz" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== CAMPOS DE TEXTO =====================
             Borde azul de 2 px cuando el campo tiene el foco de teclado (indicador visible). -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Background" Value="{StaticResource BrSuperficie}"/>
            <Setter Property="BorderBrush" Value="#B5B5AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="#7A7A75"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource BrFoco}"/>
                                <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CampoPassword" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Background" Value="{StaticResource BrSuperficie}"/>
            <Setter Property="BorderBrush" Value="#B5B5AF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="#7A7A75"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource BrFoco}"/>
                                <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== CONTENEDORES ===================== -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrSuperficie}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="Insignia" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>


        <!-- Pestaña (RadioButton): Novedades / Mejores precios / Ofertas en Inicio.
             La pestaña activa se marca con texto en negrita y una línea del color de acento. -->
        <Style x:Key="Pestana" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource BrSecundario}"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="0,2,0,8" RecognizesAccessKey="True"/>
                            <Rectangle x:Name="Linea" Height="2" VerticalAlignment="Bottom"
                                       Fill="{StaticResource BrAcento}" Visibility="Hidden"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrTexto}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Linea" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta de producto reutilizada en Inicio y en Galería (consistencia).
             No tiene tamaño fijo: ocupa la celda de la cuadrícula que la contiene, así las tarjetas
             siempre caben en la ventana sin barra de desplazamiento. La ilustración ocupa el espacio
             sobrante y los textos largos se recortan con «…». -->
        <DataTemplate x:Key="PlantillaTarjetaCoche" DataType="{x:Type m:Coche}">
            <Button Style="{StaticResource BtnTarjeta}" Margin="6"
                    AutomationProperties.Name="{Binding NombreAccesible}" ToolTip="Ver detalles del modelo">
                <Border Style="{StaticResource Tarjeta}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="56"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Foto real del modelo: rellena la zona superior recortando lo que sobra (UniformToFill).
                             El color de fondo solo se ve mientras la foto carga. -->
                        <Border CornerRadius="7,7,0,0" Background="{Binding Fondo}"/>
                        <Border CornerRadius="7,7,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Foto}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Top">
                            <Border Style="{StaticResource Insignia}"
                                    Visibility="{Binding EsNovedad, Converter={StaticResource BoolAVisibilidad}}">
                                <TextBlock Text="Novedad" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrTexto}"/>
                            </Border>
                            <Border Style="{StaticResource Insignia}" Background="{StaticResource BrAcento}"
                                    Visibility="{Binding TieneOferta, Converter={StaticResource BoolAVisibilidad}}">
                                <TextBlock Text="Oferta" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrTexto}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="14,10,14,12">
                            <TextBlock Text="{Binding Modelo}" Style="{StaticResource TxtH3}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Version}" Style="{StaticResource TxtSecundario}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            <TextBlock Style="{StaticResource TxtSecundario}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Margin="0,1,0,0">
                                <Run Text="{Binding Tipo, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AutonomiaTexto, Mode=OneWay}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding PrecioTexto}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource BrTexto}"/>
                                <TextBlock Text="{Binding PrecioOriginalTexto}" TextDecorations="Strikethrough"
                                           Style="{StaticResource TxtSecundario}" TextWrapping="NoWrap" Margin="8,0,0,2"
                                           VerticalAlignment="Bottom"
                                           Visibility="{Binding TieneOferta, Converter={StaticResource BoolAVisibilidad}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

    </Application.Resources>
</Application>
