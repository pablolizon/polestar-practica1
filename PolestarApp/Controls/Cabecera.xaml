<UserControl x:Class="PolestarApp.Controls.Cabecera"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cabecera común a todas las ventanas: logotipo, menú de navegación e indicador de sesión.
         Se define una sola vez y cada ventana la incluye con <c:Cabecera Seccion="..."/> -->
    <Border Background="{StaticResource BrSuperficie}"
            BorderBrush="{StaticResource BrBorde}" BorderThickness="0,0,0,1">
        <Grid Height="64" Margin="32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 1. LOGOTIPO. Marcador de texto: sustituir por el logotipo oficial
                 (Assets/) citando su origen y condiciones de uso. Al pulsarlo vuelve a Inicio. -->
            <Button x:Name="BtnLogo" Grid.Column="0" Style="{StaticResource BtnLogo}" Click="BtnInicio_Click"
                    ToolTip="Ir a inicio" AutomationProperties.Name="Polestar, ir a inicio">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="POLESTAR" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource BrTexto}"/>
                    <Border Background="{StaticResource BrSuperficieAlt}" CornerRadius="3" Padding="6,2"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Store" FontSize="11" Foreground="{StaticResource BrSecundario}"/>
                    </Border>
                </StackPanel>
            </Button>

            <!-- 2. MENÚ DE NAVEGACIÓN. La sección activa se marca con un subrayado animado. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        AutomationProperties.Name="Menú principal">
                <Button x:Name="BtnNavInicio"  Style="{StaticResource BtnNav}" Content="_Inicio"
                        Click="BtnInicio_Click" ToolTip="Novedades, ofertas y campañas (Alt+I)"/>
                <Button x:Name="BtnNavGaleria" Style="{StaticResource BtnNav}" Content="_Galería"
                        Click="BtnGaleria_Click" ToolTip="Todos los modelos (Alt+G)"/>
                <Button x:Name="BtnNavAcceso"  Style="{StaticResource BtnNav}" Content="_Acceso clientes"
                        Click="BtnAcceso_Click" ToolTip="Iniciar sesión (Alt+A)"/>
            </StackPanel>

            <!-- 3. INDICADOR DE SESIÓN (componente común añadido; justificado en la documentación) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource BrSuperficieAlt}">
                    <TextBlock Text="&#xE77B;" Style="{StaticResource TxtIcono}" HorizontalAlignment="Center"
                               Foreground="{StaticResource BrSecundario}"/>
                </Border>
                <TextBlock x:Name="TxtSesion" Text="Invitado" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource BrTexto}"/>
                <Button x:Name="BtnCerrarSesion" Content="Cerrar sesión" Style="{StaticResource BtnEnlace}"
                        Margin="12,0,0,0" Visibility="Collapsed" Click="BtnCerrarSesion_Click"
                        Foreground="{StaticResource BrSecundario}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
